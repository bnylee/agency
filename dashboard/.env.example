# Copy to .env and set a real value.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# The token is sent as the x-agency-token REQUEST HEADER, never as a cookie.
# That is deliberate: a cookie would be attached automatically by the browser to
# requests originating from any page, so a malicious site could trigger a bot run
# just by getting you to visit it. A custom header cannot be set cross-origin
# without CORS permission the server never grants, so it is the CSRF defence.
AGENCY_TOKEN=replace-me

# Loopback only. Changing this to 0.0.0.0 exposes an endpoint that runs local
# PowerShell to every device on your network. The server refuses to start on a
# non-loopback host.
AGENCY_HOST=127.0.0.1
AGENCY_PORT=7777
