# The public demo build (`npm run build:demo`). Checked in on purpose — there is
# no secret here, and the whole point of this file is that the demo build is
# reproducible by anyone who clones the repo.
#
# VITE_DEMO=1 routes src/api.ts through src/demo/fixtures.ts instead of fetch,
# and skips the token gate. There is no server in this build and no token to
# check; a password prompt in front of it would ask for a secret that does not
# exist.
VITE_DEMO=1

# GitHub Pages serves a project site from /<repo>/. Override with a real
# environment variable if the repo is renamed or moved to a user site.
VITE_BASE=/agency/
