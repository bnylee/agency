# media-bot credentials. Copy to .env and fill in what you have.
#
# .env is gitignored and BOTH the agent's read guard and its deny rules refuse to
# open it. Only scripts/collect.py and scripts/triage.py read it, and they are
# invoked by run_sweep.ps1 rather than by the model.
#
# Every provider is independent. Fill in one and the bot works with one; the rest
# report `not_configured` with the setup step, every run, until you get to them.
# That is a state, not an error, and it does not turn the run red.

# ----------------------------------------------------------------------- Gmail
# An APP PASSWORD, not your Google password. Google Account > Security >
# App passwords. Requires 2-Step Verification to be on; turning 2SV off later
# revokes every app password silently.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ---------------------------------------------------------------------- Canvas
# Canvas > Account > Settings > Approved Integrations > + New Access Token.
# Set an expiry you will remember; the bot reports a 401 clearly when it lapses.
CANVAS_BASE_URL=https://northeastern.instructure.com
CANVAS_TOKEN=

# ------------------------------------------------------------- Outlook / M365
# The Application (client) ID from an Azure app registration. See the docstring at
# the top of scripts/graph_login.py for the four settings that matter — especially
# "Allow public client flows: Yes", without which device code fails with an error
# that does not mention it.
#
# After setting this, run ONCE, by hand, in a terminal:
#     python scripts/graph_login.py
GRAPH_CLIENT_ID=
# "common" works for both a personal Microsoft account and a school tenant. Set a
# tenant id only if your registration is single-tenant.
GRAPH_TENANT=common

# -------------------------------------------------------------------- Calendars
# Comma-separated published .ics URLs. This is the calendar path that needs no app
# registration at all, so it is the one to set up first.
#   Outlook: Calendar > Share > Publish a calendar > ICS link
#   Google:  Settings > (your calendar) > Secret address in iCal format
# Treat these as passwords: anyone holding one can read the whole calendar.
ICS_URLS=

# ------------------------------------------------------------------- Classifier
# Extra sender domains that must never be classified as junk, comma-separated.
# northeastern.edu, neu.edu subdomains and instructure.com are already built in;
# see IMPORTANT_DOMAINS in scripts/classify.py.
# Keep this SHORT. Every domain here is one that can no longer be binned, so a
# broad entry (gmail.com) switches the classifier off.
IMPORTANT_DOMAINS=

# ----------------------------------------------------------- Not configurable
# Instagram, TikTok and Snapchat have no personal notification API and there is
# nothing to put here for them. Their activity EMAILS are classified from mail
# instead. See the table at the top of scripts/providers.py.
